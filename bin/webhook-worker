#!/usr/bin/env ruby
# frozen_string_literal: true

# Runs webhook delivery workers: N threads in this process, each claiming due
# deliveries from Postgres. Start as many processes as you like; they coordinate
# only through the database. TERM or INT stops after the current deliveries.
#
#   bin/webhook-worker --threads 8
#   bin/webhook-worker --mode fifo      # the baseline experiment 6 compares against
#
# Uses the wall clock (Clock::Real). --test-mode allows http://localhost and
# http://127.0.0.1 URLs, for local experiments only.
require 'bundler/setup'
require 'optparse'
require_relative '../lib/clearinghouse'

options = { threads: 8, mode: 'isolated', max_in_flight: 4, breaker_threshold: 5, breaker_cooldown: 30.0,
            breaker_max_cooldown: 600.0, lease: 60.0, connect_timeout: 2.0, read_timeout: 5.0, total_timeout: 10.0,
            idle_sleep: 0.05, test_mode: false, seed: nil, log: false }
OptionParser.new do |opts|
  opts.banner = 'Usage: bin/webhook-worker [options]'
  opts.on('--threads N', Integer, 'delivery threads (default 8)') { |v| options[:threads] = v }
  opts.on('--mode MODE', %w[isolated fifo], 'isolated (default) or fifo') { |v| options[:mode] = v }
  opts.on('--max-in-flight N', Integer, 'per endpoint, isolated mode (default 4)') { |v| options[:max_in_flight] = v }
  opts.on('--breaker-threshold N', Integer, 'consecutive failures to open (default 5)') do |v|
    options[:breaker_threshold] = v
  end
  opts.on('--breaker-cooldown SECONDS', Float, 'first open period (default 30)') { |v| options[:breaker_cooldown] = v }
  opts.on('--breaker-max-cooldown SECONDS', Float, 'longest open period (default 600)') do |v|
    options[:breaker_max_cooldown] = v
  end
  opts.on('--lease SECONDS', Float, 'lease per claim (default 60)') { |v| options[:lease] = v }
  opts.on('--connect-timeout SECONDS', Float, 'default 2') { |v| options[:connect_timeout] = v }
  opts.on('--read-timeout SECONDS', Float, 'default 5') { |v| options[:read_timeout] = v }
  opts.on('--total-timeout SECONDS', Float, 'default 10') { |v| options[:total_timeout] = v }
  opts.on('--idle-sleep SECONDS', Float, 'poll interval when nothing is due (default 0.05)') do |v|
    options[:idle_sleep] = v
  end
  opts.on('--seed N', Integer, 'seed for retry jitter (default random)') { |v| options[:seed] = v }
  opts.on('--test-mode', 'allow http://localhost URLs') { options[:test_mode] = true }
  opts.on('--log', 'one JSON line per attempt on stdout') { options[:log] = true }
end.parse!

$stdout.sync = true
db = Clearinghouse::DB.connect(role: :app, max_connections: options[:threads] + 1)
clock = Clearinghouse::Clock::Real.new
http = Clearinghouse::Webhooks::SafeHttp.new(
  resolver: Clearinghouse::Webhooks::Egress::SystemResolver.new, test_mode: options[:test_mode],
  connect_timeout: options[:connect_timeout], read_timeout: options[:read_timeout],
  total_timeout: options[:total_timeout]
)
queue = if options[:mode] == 'fifo'
          Clearinghouse::Webhooks::FifoQueue.new
        else
          breaker = Clearinghouse::Webhooks::CircuitBreaker.new(
            failure_threshold: options[:breaker_threshold], cooldown: options[:breaker_cooldown],
            max_cooldown: options[:breaker_max_cooldown]
          )
          Clearinghouse::Webhooks::IsolatedQueue.new(max_in_flight: options[:max_in_flight], breaker: breaker)
        end
seed = options[:seed] || Random.new_seed
log = options[:log] ? $stdout : nil
pool = Clearinghouse::Webhooks::WorkerPool.new(threads: options[:threads], idle_sleep: options[:idle_sleep],
                                               log: $stderr) do |index|
  Clearinghouse::Webhooks::Worker.new(db: db, clock: clock, http: http, queue: queue, rng: Random.new(seed + index),
                                      lease_seconds: options[:lease], name: "#{Process.pid}-#{index}", log: log)
end

%w[TERM INT].each { |signal| trap(signal) { Thread.new { pool.stop } } }
warn "webhook-worker #{Process.pid}: #{options[:threads]} threads, #{queue.mode}"
pool.start.wait
