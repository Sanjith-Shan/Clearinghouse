#!/usr/bin/env ruby
# frozen_string_literal: true

# Regenerates docs/api-changelog.md from the registered version changes.
require 'bundler/setup'
require_relative '../lib/clearinghouse'

path = Clearinghouse::Versioning::Changelog::PATH
File.write(path, Clearinghouse::Versioning::Changelog.render(Clearinghouse::Versioning.registry))
puts "wrote #{path}"
