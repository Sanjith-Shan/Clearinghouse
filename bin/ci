#!/usr/bin/env bash
# Everything GitHub Actions runs, runnable locally. A branch merges only when this passes.
# CLEARINGHOUSE_STRICT_TIMING=1 also runs the strict wall-clock specs tagged :timing
# (docs/design/testing-timing.md); run it that way on a quiet machine.
set -euo pipefail
cd "$(dirname "$0")/.."
export CLEARINGHOUSE_ENV=test
export CLEARINGHOUSE_DB="${CLEARINGHOUSE_DB:-clearinghouse_test}"
echo "== srb tc";   bundle exec srb tc
echo "== rubocop";  bundle exec rubocop
echo "== migrate";  bin/migrate
echo "== rspec";    COVERAGE_GATE=1 bundle exec rspec  # enforces spec/coverage_groups.rb floors
if [ -d clients/go ]; then echo "== go test"; (cd clients/go && go test ./...); fi
if [ -d sim/loadgen ]; then
  echo "== loadgen vet"; (cd sim/loadgen && go vet ./...)
  echo "== loadgen test"; (cd sim/loadgen && go test ./...)
fi
