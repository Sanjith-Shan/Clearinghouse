#!/usr/bin/env ruby
# frozen_string_literal: true

# The background worker for requests nobody is finishing, and for time-driven
# housekeeping. Each tick it:
#
#   1. cancels authorizations past their capture window (Payments::Expiry),
#   2. drives abandoned idempotent requests to completion (Idempotency::Completer),
#   3. deletes finished idempotency keys older than 24 hours (Idempotency::Reaper),
#
# and prints one JSON line saying what it did. Configured like the API server
# (CLEARINGHOUSE_DB, CLEARINGHOUSE_ACQUIRER_URL, RISKGATE_URL,
# CLEARINGHOUSE_IDEMPOTENCY_LOCK_TIMEOUT).
#
#   bin/completer [--once] [--interval SECONDS] [--grace SECONDS] [--limit N]
#
# --grace is how long an unlocked, unfinished key must have been idle before the
# completer takes it (default: the lock timeout), which leaves a client that was
# told to retry time to do it itself.

require 'bundler/setup'
require 'json'
require 'optparse'
require_relative '../lib/clearinghouse'

options = { once: false, interval: 5.0, grace: nil, limit: 100 }
OptionParser.new do |opts|
  opts.on('--once') { options[:once] = true }
  opts.on('--interval SECONDS', Float) { |v| options[:interval] = v }
  opts.on('--grace SECONDS', Float) { |v| options[:grace] = v }
  opts.on('--limit N', Integer) { |v| options[:limit] = v }
end.parse!
$stdout.sync = true

deps = Clearinghouse::Api::Dependencies.from_env
completer = Clearinghouse::Api::Completion.completer(deps, grace: options[:grace])
loop do
  expired = Clearinghouse::Payments::Expiry.sweep!(deps)
  report = completer.run_once(limit: options[:limit])
  reaped = Clearinghouse::Idempotency::Reaper.run(deps.db, clock: deps.clock)
  puts JSON.generate(time: deps.clock.now.iso8601(3), completed: report.completed, busy: report.busy,
                     failed: report.failed.to_h, expired: expired, reaped: reaped.deleted, stuck: reaped.stuck)
  break if options[:once]

  sleep options[:interval]
end
